{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "routes": [
    {
      "src": "/api/alexa",
      "dest": "/api/alexa.py"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    }
  ]
}
